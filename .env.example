HOST=127.0.0.1
PORT=3010
PUBLIC_ORIGIN=http://localhost:3010
COOKIE_SECURE=false

# Veritabani. DATABASE_URL tanimliysa PostgreSQL kullanilir, bos ise
# DATA_DIR altindaki SQLite dosyasi (yerel calistirma icin).
# DATABASE_URL=postgresql://kullanici:parola@127.0.0.1:5432/veritabani
DATA_DIR=./data

# Alt dizine kuruluyorsa (ornek: /genctektakvim). Vekil oneki soyarak koke
# iletir; bu deger yalnizca oturum cerezinin yolunu belirler.
# BASE_PATH=/genctektakvim

# Ters vekil (Apache/nginx) arkasinda calisiyorsa true yapin; giris denemesi
# sayaci istemci adresini X-Forwarded-For zincirinin son elemanindan okur.
# Dogrudan internete aciksa false.
TRUST_PROXY=false
